<article class="describe-viewer" style="background-image: url('{{imageUrl}}')">
  <button type="button" class="describe-viewer__close" data-action="close-viewer" title="Закрыть">
    <i class="fas fa-times"></i>
  </button>
  <div class="describe-viewer__scrim"></div>
  <section class="describe-viewer__card">
    <p>{{category}}</p>
    <h1>{{title}}</h1>
    <div>{{description}}</div>
  </section>
</article>
